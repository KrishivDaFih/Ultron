{
  "name": "ultron-desktop",
  "productName": "ULTRON",
  "version": "1.1.1",
  "description": "ULTRON AI assistant",
  "author": "Kris",
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.kris.ultron.desktop",
    "productName": "ULTRON",
    "copyright": "Copyright (c) 2026 Kris. Personal, non-commercial project.",
    "electronVersion": "44.5.1",
    "directories": {
      "app": "app",
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ULTRON-Setup-${version}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ULTRON",
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
